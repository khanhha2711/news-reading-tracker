{
  "manifest_version": 3,
  "name": "News Reading Tracker",
  "version": "1.0.0",
  "description": "Track reading activity on configured news websites.",

  "permissions": ["storage", "tabs", "webNavigation", "idle", "scripting"],

  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_title": "News Reading Tracker"
  }
}
